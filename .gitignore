# No trailing slash: also matches a stray node_modules SYMLINK (a dir-only
# `node_modules/` pattern let one slip into the #76 squash via `git add -A`).
node_modules
packages/*/node_modules

*.log
.DS_Store
*.tsbuildinfo
*.cpuprofile

# Pi project local state (skills/mcp/agents may also live under .pi/ when
# authored in-tree — this monorepo keeps the whole tree local).
.pi/

# yoki project domain under Pi tree (ephemeral + generated)
.pi/yoki/artifacts/
**/.pi/yoki/artifacts/
.pi/yoki/workflows/
**/.pi/yoki/workflows/
.pi/yoki/guidance/
**/.pi/yoki/guidance/
.pi/yoki/todo/
**/.pi/yoki/todo/

# transition: pre-migration project domain (remove after migration window)
.yoki/guidance/
**/.yoki/guidance/
.yoki/artifacts/
**/.yoki/artifacts/
.yoki/workflows/
**/.yoki/workflows/
.pi/yoki-todo/
**/.pi/yoki-todo/
thoughts/

# Environment
.env

# Editor files
.vscode/
.zed/
.idea/
*.swp
*.swo
*~

# Agent metadata (Claude Code local session state)
.claude/

# Package specific
.npm/
coverage/
.nyc_output/
packages/yoki-site/dist/
packages/*/.astro/
# Astro generates a `.astro/` cache wherever it's invoked from. The
# packages-level rule above doesn't cover the case of running Astro from the
# monorepo root (e.g. via a workspace script), so ignore the root cache too.
/.astro/
