{
  "name": "yoki_ui",
  "version": "0.1.0",
  "description": "Pi TUI package: yoki_themes theme + statusline, Pi header, Codex-style editor, and window-title feedback.",
  "type": "module",
  "exports": {
    ".": "./yoki_ui/index.ts",
    "./style": "./yoki_ui/style.ts"
  },
  "keywords": [
    "pi-package",
    "pi",
    "tui",
    "theme",
    "statusline",
    "window-title",
    "yoki_themes",
    "yoki"
  ],
  "license": "MIT",
  "files": [
    "yoki_ui",
    "themes",
    "assets",
    "README.md",
    "STYLE.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts && vitest run --root ../.. packages/yoki-ui/test/window-title"
  },
  "pi": {
    "extensions": [
      "./yoki_ui/index.ts"
    ],
    "themes": [
      "./themes"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "dependencies": {
    "@yoki/yoki-config": "^1.20.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@types/node": "^22.19.19",
    "typescript": "^6.0.3"
  }
}
