{
  "name": "yoki-mono",
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "biome check --error-on-warnings . && tsc --noEmit -p tsconfig.base.json",
    "check:yoki-newapi": "npm run typecheck --workspace=pi-provider-newapi",
    "test:yoki-newapi": "npm run test --workspace=pi-provider-newapi",
    "check:yoki-skills": "npm run typecheck --workspace=pi-codex-skills",
    "test:yoki-skills": "npm run test --workspace=pi-codex-skills",
    "smoke:yoki-skills": "npm run test:pi-smoke --workspace=pi-codex-skills",
    "check:yoki-ui": "npm run typecheck --workspace=yoki_ui",
    "test:yoki-ui": "npm run test --workspace=yoki_ui",
    "check:yoki-mcp-adapter": "npm run check --workspace=pi-mcp-adapter",
    "test:yoki-mcp-adapter": "npm run test --workspace=pi-mcp-adapter",
    "check:hygiene": "node scripts/check-no-nested-node-modules.mjs",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "version:patch": "npm version patch -ws --no-git-tag-version && node scripts/sync-versions.js",
    "version:minor": "npm version minor -ws --no-git-tag-version && node scripts/sync-versions.js",
    "version:major": "npm version major -ws --no-git-tag-version && node scripts/sync-versions.js",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "prepare": "husky"
  },
  "pi": {
    "extensions": [
      "./packages/yoki-ask-user-question/index.ts",
      "./packages/yoki-plan/index.ts",
      "./packages/yoki-todo/index.ts",
      "./packages/yoki-warp-notify/index.ts",
      "./packages/yoki-web-tools/index.ts",
      "./packages/yoki-image-gen/index.ts",
      "./packages/yoki-newapi/index.ts",
      "./packages/yoki-skills/extensions/pi-codex-skills/index.ts",
      "./packages/yoki-ui/yoki_ui/index.ts",
      "./packages/yoki-mcp-adapter/mcp-adapter/index.ts",
      "./packages/pi-telegram-main/index.ts"
    ],
    "skills": [
      "./packages/yoki-web-tools/skills",
      "./packages/yoki-skills/skills"
    ],
    "themes": [
      "./packages/yoki-ui/themes"
    ]
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.80.5",
    "@earendil-works/pi-coding-agent": "0.80.5",
    "@earendil-works/pi-tui": "0.80.5",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@mozilla/readability": "^0.6.0",
    "@standard-schema/spec": "^1.0.0",
    "@tintinweb/pi-subagents": "^0.6.3",
    "decibri": "^3.4.0",
    "jiti": "^2.7.0",
    "linkedom": "^0.16.0",
    "p-limit": "^6.1.0",
    "sherpa-onnx-node": "^1.13.0",
    "turndown": "^7.2.0",
    "typebox": "^1.1.34",
    "unpdf": "^1.6.2",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@earendil-works/pi-ai": "0.80.5",
    "@earendil-works/pi-coding-agent": "0.80.5",
    "@earendil-works/pi-tui": "0.80.5",
    "typebox": "^1.1.34",
    "@types/node": "^22.19.19",
    "@vitest/coverage-v8": "^4.0.0",
    "husky": "^9.1.7",
    "shx": "^0.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=11.0.0"
  },
  "overrides": {
    "@mariozechner/pi-coding-agent": "npm:@earendil-works/pi-coding-agent@0.80.5",
    "@mariozechner/pi-ai": "npm:@earendil-works/pi-ai@0.80.5",
    "@mariozechner/pi-tui": "npm:@earendil-works/pi-tui@0.80.5"
  }
}
