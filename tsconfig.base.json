{
	"compilerOptions": {
		"target": "ES2022",
		"module": "Node16",
		"moduleResolution": "Node16",
		"lib": [
			"ES2022",
			"DOM"
		],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"types": [
			"node"
		]
	},
	"include": [
		"packages/*/**/*.ts",
		"test/**/*.ts",
		"vitest.config.ts"
	],
	"exclude": [
		"**/node_modules/**",
		"**/.pi/**",
		"**/.yoki/**",
		"**/dist/**",
		"packages/yoki-newapi/**",
		"packages/yoki-skills/**",
		"packages/yoki-ui/**",
		"packages/yoki-mcp-adapter/**"
	]
}
